# Leave VITE_API_URL unset in development to use the Vite proxy.
# Set them when the API lives on another origin.
# VITE_API_URL=https://api.example.com/api
# VITE_HUB_URL=https://api.example.com/hubs

# Optional fallback. The LiveKit token endpoint also returns the server URL,
# so the frontend can use that value instead of a build-time variable.
# VITE_LIVEKIT_URL=wss://livekit.example.com
